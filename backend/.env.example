# ========================================================
# SERVER MONITOR - CONFIGURAÇÃO DE AMBIENTE (Ubuntu Server)
# Copie este arquivo para .env no mesmo diretório:
# cp .env.example .env
# ========================================================

# Autenticação do Administrador (Obrigatório para acesso remoto)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=alterar_esta_senha_super_segura

# Chave de API opcional para autenticação rápida via Header (X-API-Key: sua_chave)
# Se preenchido, você pode usar tanto Basic Auth quanto X-API-Key
API_KEY=chave_secreta_opcional_para_api

# Configurações de Rede da API
HOST=0.0.0.0
PORT=8000

# CORS: Lista de origens permitidas separadas por vírgula.
# Exemplo: https://meu-dashboard.vercel.app,https://meu-dominio.com,http://localhost:3000
# Para permitir todas as origens temporariamente durante testes: *
CORS_ORIGINS=*

# Integração AdGuard Home (Opcional - deixe vazio ou comente se não usar)
# URL local onde o AdGuard Home está escutando (geralmente porta 3000 ou 8081)
ADGUARD_URL=http://127.0.0.1:8081
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
