[Unit]
Description=Server Monitor - Backend API de Telemetria e Monitoramento em Tempo Real
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Usuário e Grupo (Recomenda-se criar um usuário dedicado ou usar seu usuário habitual)
User=root
Group=root

# Diretório de trabalho onde o código e o .env estão instalados
WorkingDirectory=/opt/server-monitor

# Carrega as variáveis do arquivo .env
EnvironmentFile=/opt/server-monitor/.env

# Execução através do executável uvicorn dentro do ambiente virtual Python isolado
ExecStart=/opt/server-monitor/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1 --log-level info

# Política de reinicialização robusta em caso de falhas
Restart=always
RestartSec=5s

# Sandboxing de Segurança do systemd
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

# Logs redirecionados para o journald do sistema
StandardOutput=journal
StandardError=journal
SyslogIdentifier=server-monitor

[Install]
WantedBy=multi-user.target
