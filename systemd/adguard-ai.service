[Unit]
Description=AdGuard Home AI - Analisador Inteligente de Bloqueios
After=network.target adguard-home.service

[Service]
Type=simple
User=samuel
SupplementaryGroups=adm systemd-journal
WorkingDirectory=/home/samuel/adguard-home-ai
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=ADGUARD_URL=http://127.0.0.1:8081
Environment=ADGUARD_USERNAME=samuel
Environment=ADGUARD_PASSWORD=sua_senha_adguard
Environment=OPENCODE_BIN=/home/samuel/.opencode/bin/opencode
Environment=OPENCODE_HOME=/home/samuel
Environment=OPENCODE_DIR=/home/samuel/opencode
Environment=OPENCODE_MODEL=opencode/big-pickle
Environment=OPENCODE_AGENT=plan

ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
