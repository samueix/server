# ==============================================================================
# Variáveis de Ambiente - Server Monitor & AdGuard AI NOC Panel
# ==============================================================================

# Porta do Painel Web Node.js (Padrão: 3000)
PORT=3000
NODE_ENV=production

# Chave de API do Google Gemini (Opcional - para o dossiê inteligente de domínios)
GEMINI_API_KEY=

# Conexão com o AdGuard Home (API interna / proxy)
ADGUARD_URL=http://127.0.0.1:8081
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Conexão com o Agente de Telemetria Python (FastAPI na porta 8000)
BACKEND_URL=http://127.0.0.1:8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Origem permitida para CORS no Node.js (opcional, padrão: mesma origem do painel sem cabeçalho CORS)
ALLOWED_ORIGIN=

# Credenciais do Painel e do Agente
# Administrador (libera todos os módulos, comandos, serviços, logs e n8n)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Usuário Padrão / Operador (acesso restrito unicamente à telemetria geral)
USER_USERNAME=user
USER_PASSWORD=

# Senha mestra do cofre seguro de senhas (Security Vault)
VAULT_PASSWORD=

# Credenciais SSH do host devolvidas unicamente pelo cofre desbloqueado no backend (opcional)
VAULT_SSH_USER=
VAULT_SSH_PASSWORD=

# Chave de API secreta para comunicação interna segura (opcional)
API_KEY=

# Integração n8n Workflow Automation (porta 5678)
N8N_URL=http://192.168.100.23:5678
N8N_API_KEY=
